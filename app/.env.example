# Client-side (Vite embeds these at build time — must be set BEFORE `npm run build`,
# and in Vercel's Project Settings → Environment Variables before deploying).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (used by api/briefing.ts and api/moderate.ts — never exposed
# to the browser). Set this in Vercel's Environment Variables, NOT with a VITE_
# prefix.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
